# ==============================================================================
# SEAMI - CONFIGURAÇÕES GERAIS (DJANGO)
# ==============================================================================
DEBUG=False
SECRET_KEY=django-insecure-altere-esta-chave-para-uma-chave-longa-e-segura-em-producao
ALLOWED_HOSTS=localhost,127.0.0.1,seami.seudominio.com.br,web
CSRF_TRUSTED_ORIGINS=https://seami.seudominio.com.br,http://localhost:8000

# ==============================================================================
# POSTGRESQL (DB)
# ==============================================================================
POSTGRES_DB=seami_db
POSTGRES_USER=seami_user
POSTGRES_PASSWORD=seami_super_secret_password_123
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://seami_user:seami_super_secret_password_123@db:5432/seami_db

# ==============================================================================
# REDIS (CACHE & QUEUES)
# ==============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/1

# ==============================================================================
# N8N (AUTOMAÇÃO DE WORKFLOWS)
# ==============================================================================
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=uma_chave_aleatoria_hex_ou_string_muito_segura_32_chars
